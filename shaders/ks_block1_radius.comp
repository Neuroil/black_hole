// ══════════════════════════════════════════════════════════════
// 第一块：Kerr 椭球半径 r(x, y, z)
// ══════════════════════════════════════════════════════════════
//
// Kerr-Schild 笛卡尔坐标下，"半径" r 不是球坐标 √(x²+y²+z²)，
// 而是 Kerr 特有的椭球坐标，由下式隐式定义：
//
//     x² + y² + z² = r² + a²(1 - z²/r²)
//
// 整理成关于 r² 的二次方程：
//     r⁴ - (ρ² - a²)·r² - a²·z² = 0,   其中 ρ² = x² + y² + z²
//
// 解出正根：
//     r² = ½[ (ρ² - a²) + √((ρ² - a²)² + 4a²z²) ]
//
// a = 0 时退化为 r² = ρ²，即普通球坐标半径（史瓦西）。
// ══════════════════════════════════════════════════════════════

float kerrRadius(vec3 p, float a2) {
    float rho2 = dot(p, p);              // x² + y² + z²
    float t    = rho2 - a2;
    // 判别式恒 ≥ 0（4a²z² ≥ 0），但加 max 防浮点负零
    float disc = sqrt(max(t * t + 4.0 * a2 * p.z * p.z, 0.0));
    float r2   = 0.5 * (t + disc);
    return sqrt(max(r2, 0.0));
}

// ══════════════════════════════════════════════════════════════
// 验证用：把 r 映射成颜色，肉眼检查椭球结构是否正确
// ══════════════════════════════════════════════════════════════
//
// 在 main() 里临时替换掉测地线追踪，直接对每个像素：
//   1. 用相机方向算出一个测试点（不积分，就取相机前方某固定距离的点）
//   2. 算该点的 kerrRadius
//   3. 按 r 上色
//
// 预期现象（相机在赤道面外侧看向黑洞）：
//   - a = 0：等 r 面是同心球 → 颜色呈同心圆，完全各向同性
//   - a > 0：等 r 面是椭球 → 颜色在自转轴(z)方向被压扁，
//            赤道方向"鼓"出来，呈椭圆状条纹
//   - z = 0 平面上：r = √(ρ² - a²) 在 ρ → a 处趋于 0（环奇点边缘）
//
// 关键验证点：a > 0 时颜色条纹必须是【椭圆】而非正圆。
//            若仍是正圆，说明 a 没传进来或 kerrRadius 写错。
// ══════════════════════════════════════════════════════════════

vec3 debugRadiusColor(float r, float M) {
    // 用视界半径 r_h = M + √(M²-a²) 做归一化基准
    // 这里简单用 r / (10M) 映射到 [0,1] 的彩虹色带
    float t = clamp(r / (10.0 * M), 0.0, 1.0);

    // 简易 turbo-ish 彩虹：低 r 红 → 高 r 蓝，便于看清等值线
    vec3 c;
    c.r = clamp(1.5 - abs(4.0 * t - 3.0), 0.0, 1.0);
    c.g = clamp(1.5 - abs(4.0 * t - 2.0), 0.0, 1.0);
    c.b = clamp(1.5 - abs(4.0 * t - 1.0), 0.0, 1.0);

    // 每 0.5M 画一条等值线（黑色细纹），凸显椭球形状
    float ring = smoothstep(0.45, 0.5, fract(r / 0.5));
    c *= (1.0 - 0.5 * ring);

    return c;
}

// ══════════════════════════════════════════════════════════════
// 临时验证版 main()
// ══════════════════════════════════════════════════════════════
//
// 把你现在的 main() 整个换成这个来验证第一块。
// 验证通过后再换回真正的测地线追踪。
// ══════════════════════════════════════════════════════════════

void main() {
    ivec2 pix  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    float M  = spacetime.bhParams.x;
    float a  = spacetime.bhParams.y;
    float a2 = a * a;

    // 相机位置（Kerr-Schild 笛卡尔，黑洞在原点，自转轴 = z）
    // 注意：迁移后 camPos 应直接是笛卡尔 (x, y, z)，不再是 BL (r,θ,φ)
    // 验证阶段先硬编码一个赤道面外的相机
    vec3 camPos = vec3(30.0, 0.0, 3.0);   // 稍微抬高一点，能看到 z 方向压扁

    // NDC → 笛卡尔方向
    vec2 uv = (vec2(pix) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec4 wd4 = cam.invViewProj * vec4(uv, 1.0, 1.0);
    vec3 dir = normalize(wd4.xyz / wd4.w - camPos);

    // 不积分：沿直线推进，对每个采样点算 kerrRadius 并取靠近黑洞的最小 r
    // 这样能"切"出一张等 r 面的剖面图
    float minR = 1e30;
    vec3 p = camPos;
    for (int i = 0; i < 200; i++) {
        p += dir * 0.3;
        float r = kerrRadius(p, a2);
        minR = min(minR, r);
        // 穿过黑洞区域后就停（避免远端无意义采样）
        if (dot(p, p) < 1.0) break;
        if (length(p) > 60.0 && dot(p, dir) > 0.0) break;
    }

    vec3 color = debugRadiusColor(minR, M);
    imageStore(outImage, pix, vec4(color, 1.0));
}
