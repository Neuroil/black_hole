#version 450

layout(local_size_x = 16, local_size_y = 16) in;

// 输出图像
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

// UBO：相机参数
layout(set = 0, binding = 1) uniform CameraUBO {
    vec3  camPos;
    float pad0;
    mat4  invViewProj;
    float rs;          // 史瓦西半径
    float stepSize;
    int   maxSteps;
    float escapeRadius;
} cam;

// -------- 测地线积分（与 GLSL 版本完全相同）--------

vec3 geodesicAccel(vec3 pos, vec3 dir) {
    float r2 = dot(pos, pos);
    float r  = sqrt(r2);
    float factor = -1.5 * cam.rs / (r2 * r);
    float proj   = dot(dir, pos) / dot(dir, dir);
    return factor * (pos - proj * dir);
}

void rk4Step(inout vec3 pos, inout vec3 dir, float h) {
    vec3 p1 = dir,                          d1 = geodesicAccel(pos, dir);
    vec3 p2 = dir + d1*(h/2.0),             d2 = geodesicAccel(pos + p1*(h/2.0), dir + d1*(h/2.0));
    vec3 p3 = dir + d2*(h/2.0),             d3 = geodesicAccel(pos + p2*(h/2.0), dir + d2*(h/2.0));
    vec3 p4 = dir + d3*h,                   d4 = geodesicAccel(pos + p3*h,       dir + d3*h);

    pos += (h/6.0) * (p1 + 2.0*p2 + 2.0*p3 + p4);
    dir += (h/6.0) * (d1 + 2.0*d2 + 2.0*d3 + d4);
}

// -------- 背景采样（可换成 skybox 贴图）--------

vec3 sampleBackground(vec3 dir) {
    vec3 d = normalize(dir);

    // 银河背景
    float galaxy = exp(-abs(d.y) * 8.0) * 0.15;
    vec3 bg = vec3(galaxy * 0.3, galaxy * 0.4, galaxy * 0.8);

    // 星点
    vec3 sd = floor(d * 200.0);
    float h = fract(sin(dot(sd, vec3(127.1, 311.7, 74.3))) * 43758.5);
    float star = step(0.997, h);
    bg += vec3(fract(h * 17.3) * star);

    return bg;
}

vec4 trace(vec3 origin, vec3 dir) {
    vec3 pos = origin;

    for (int i = 0; i < cam.maxSteps; i++) {
        float r = length(pos);

        if (r < cam.rs * 1.02)
        return vec4(0.0, 0.0, 0.0, 1.0);   // 黑洞

        if (r > cam.escapeRadius)
        return vec4(sampleBackground(dir), 1.0);

        float h = max(0.01, (r - cam.rs) / cam.rs) * cam.stepSize;
        rk4Step(pos, dir, h);
    }

    return vec4(0.05, 0.0, 0.1, 1.0); // 超出步数
}

void main() {
    ivec2 pix  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (pix.x >= size.x || pix.y >= size.y) return;

    // NDC → 世界空间射线
    vec2 uv  = (vec2(pix) + 0.5) / vec2(size) * 2.0 - 1.0;
    vec4 wPos = cam.invViewProj * vec4(uv, 1.0, 1.0);
    vec3 dir  = normalize(wPos.xyz / wPos.w - cam.camPos);

    vec4 color = trace(cam.camPos, dir);
    imageStore(outImage, pix, color);
}